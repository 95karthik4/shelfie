# Copy to backend/.env and fill in real values. backend/.env is gitignored;
# this example file is committed and must never contain a real secret.
#
# config/settings.py loads backend/.env with os.environ.setdefault(), so a
# variable already exported in your shell always wins over the file.

# --- Hosted VLM (required) ---------------------------------------------
# Read by vlm/gemini.py. Without both of these, POST /api/scans/ returns a
# structured 503 (code "configuration") rather than failing obscurely.

# Gemini Developer API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model id. Never hardcoded in application code -- it is read from here.
# The measurements reported in the README were taken with this model.
GEMINI_MODEL=gemini-3.6-flash

# --- Django (optional) -------------------------------------------------
# Both have working development defaults; set them only if you need to.

# Signs nothing in this project (no auth, no sessions, no signed cookies).
# Defaults to "dev-only-insecure-key". Override if you ever deploy this.
# DJANGO_SECRET_KEY=replace-me-if-deploying

# "1" (default) enables Django debug mode. Set to "0" for production-like runs.
# DJANGO_DEBUG=1
