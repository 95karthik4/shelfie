# Copy to mobile/.env and set the value for your machine.
# mobile/.env is gitignored; this example file is committed.
#
# Expo inlines EXPO_PUBLIC_* variables at build time, so restart the dev server
# (npx expo start -c) after changing this.

# Where the Django API is reachable FROM THE DEVICE running the app.
#
#   iOS Simulator / Android emulator on the same Mac:
#     EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#     (Android emulator uses http://10.0.2.2:8000)
#
#   Physical iPhone on the same Wi-Fi: use the Mac's LAN IP, not localhost --
#   the phone cannot reach the Mac's loopback address. Find it with:
#     ipconfig getifaddr en0
#   then run Django with: manage.py runserver 0.0.0.0:8000
#
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
